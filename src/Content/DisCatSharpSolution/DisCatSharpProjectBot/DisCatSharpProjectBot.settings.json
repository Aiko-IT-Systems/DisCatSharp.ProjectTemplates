{
  "DisCatSharpProjectBot": {
    "Using": [
      //#if (UseInteractivity)
      "DisCatSharp.Interactivity",
      //#endif
      //#if (UseLavalink)
      "DisCatSharp.Lavalink",
      //#endif
      //#if (UseVoice)
      "DisCatSharp.Voice"
      //#endif
    ],

    "Discord": {
      "Token": "DISCORD_TOKEN",
      "Intents": "AllUnprivileged",

      "Gateway": {
        "AutoReconnect": true,
        "ReconnectIndefinitely": false,
        "LargeThreshold": 250
      },

      "Cache": {
        "MessageCacheSize": 1024,
        "AlwaysCacheMembers": false,
        "AutoRefreshChannelCache": false
      },

      "Logging": {
        "MinimumLogLevel": "Information"
      }
    }
  }
}