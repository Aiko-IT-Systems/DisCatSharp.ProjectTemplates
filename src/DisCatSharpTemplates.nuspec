<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>DisCatSharp.ProjectTemplates</id>
    <version>%VERSION%</version>
    <description>
      Project Template Pack for DisCatSharp Hosting
    </description>
    <authors>aiko, Aiko-IT-Systems, DisCatSharp, AITSYS, Jon Braunsma Jr | Badger</authors>
    <license type="expression">Apache-2.0</license>
    <readme>README.md</readme>
    <icon>logo-pride.png</icon>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
	<projectUrl>https://github.com/Aiko-IT-Systems/DisCatSharp.ProjectTemplates</projectUrl>
	<title>DisCatSharp Project Template Pack</title>
  </metadata>
  <files>
    <file src="..\README.md" target="" />
    <file src="..\logo-pride.png" target="" />
    <file src="Content\**\*.*" exclude="Content\**\bin\**\*.*;Content\**\obj\**\*.*" target="Content" />
  </files>  
</package>
